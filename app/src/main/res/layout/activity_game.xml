<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GameActivity">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginTop="80dp">

        <!-- Información del juego -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="30dp">

            <TextView
                android:id="@+id/tv_puntos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Puntos: 0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tv_nivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nivel: 1"
                android:textSize="20sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_multiplicador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multiplicador: x1"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_progreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progreso: 0/40"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_taps_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Taps totales: 0"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Botón principal para tap -->
        <Button
            android:id="@+id/btn_tapar"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:text="TAP"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp" />

        <!-- Botón de mejora -->
        <Button
            android:id="@+id/btn_mejorar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Mejorar (20 pts)"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Botón de salir -->
        <Button
            android:id="@+id/btn_salir"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Salir del Juego"
            android:textSize="18sp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>